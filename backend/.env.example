# Copy to .env and fill in. Never commit the real .env file.

# Razorpay TEST MODE keys (dashboard.razorpay.com -> Settings -> API Keys, Test Mode).
# Leave blank to run in mock mode: the agent still runs end-to-end, but Payment
# Links are fake (https://rzp.io/mock/...) instead of real Razorpay test-mode links.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Claude API key (console.anthropic.com). Leave blank to run in mock mode:
# recovery messages are generated from static templates instead of Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=4000
