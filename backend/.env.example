# Copy to .env and fill in. Never commit the real .env file.

# Razorpay TEST MODE keys (dashboard.razorpay.com -> Settings -> API Keys, Test Mode).
# Leave blank to run in mock mode: the agent still runs end-to-end, but Payment
# Links are fake (https://rzp.io/mock/...) instead of real Razorpay test-mode links.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Claude API key (console.anthropic.com) — primary recovery-message generator.
# Leave blank to fall back to GROQ_API_KEY below, or to static templates if
# neither is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional free-tier fallback (console.groq.com) used only when
# ANTHROPIC_API_KEY is blank — for local testing without Anthropic credits.
# The assignment's primary path is Claude; this is a dev-time convenience.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

PORT=4000
